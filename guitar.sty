\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{guitar}[2025/12/15 Finalni verze - opraveny krizek a velikost]

\RequirePackage{xcolor}
\RequirePackage{graphicx}

% --- Barva akordů ---
\newcommand{\guitar@chordcolor}{black}
\newcommand{\guitar@setchordcolor}[1]{%
  \renewcommand{\guitar@chordcolor}{#1}%
}

% --- Hlavní příkaz \guitarChord ---
% Použití: \guitarChord{Akord}{Písmeno}
\newcommand{\guitarChord}[2]{%
  \leavevmode
  % 1. Vrstva akordu:
  % \rlap zajistí, že akord nezabere žádné místo v řádku
  \rlap{%
    % Nastavení: 2.0ex (výška nad textem), footnotesize (velikost), bfseries (tučné)
    \raisebox{2.0ex}{%
      \normalfont\footnotesize\bfseries\color{\guitar@chordcolor}#1%
    }%
  }%
  % 2. Vrstva textu:
  #2%
}

% --- Pomocné značky (Opraveno) ---
% Používáme matematický symbol $\sharp$ místo textového #
% Velikost \footnotesize odpovídá velikosti akordu nastavené výše
\newcommand{\guitarSharp}{\raisebox{0.3ex}{\footnotesize $\sharp$}}
\newcommand{\guitarFlat}{\raisebox{0.2ex}{\footnotesize $\flat$}}

% --- Akordové schéma (pro kompatibilitu) ---
\newcommand{\gtab}[2]{%
  \textbf{#1}: \texttt{#2}%
}

\endinput